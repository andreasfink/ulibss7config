# pkg-config source file

prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Cflags: -I${includedir} 
Libs: -lulibss7config

Name: ulibss7config
Description: universal SS7 configuration library
Version: @VERSION@
Requires: ulib ulibgsmmap ulibdiameter ulibcamel ulibpcap umscript ulibtransport ulibsmpp schrittmacherclient


